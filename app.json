{
  "expo": {
    "name": "Portuguese Digital Wallet",
    "slug": "portuguese-digital-wallet",
    "version": "1.7.4",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "portuguese-digital-wallet",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "1",
      "supportsTablet": true,
      "bundleIdentifier": "pt.tecminho.pdw.ios",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 33,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "pt.tecminho.pdw"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera"
        }
      ],
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": true,
          "hidden": false,
          "style": "light"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "gradleVersion": "9.2.0",
            "buildToolsVersion": "36.0.0",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "patch-project",
      "./withUiLibFix",
      "./withAndroidReleaseSign"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ebd676a4-e5a8-497b-b9fc-b2aeb7b30974"
      }
    },
    "owner": "tecminho"
  }
}
