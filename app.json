{
  "expo": {
    "name": "Portuguese Digital Wallet",
    "slug": "portuguese-digital-wallet",
    "newArchEnabled": true,
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "portuguese-digital-wallet",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "1",
      "supportsTablet": true,
      "bundleIdentifier": "pt.tecminho.pdw"
    },
    "androidNavigationBar": {
      "backgroundColor": "#ffffff"
    },
    "android": {
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "pt.tecminho.pdw"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera"
        }
      ],
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "gradleVersion": "9.2.0",
            "buildToolsVersion": "36.0.0",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
